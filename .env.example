# ─────────────────────────────────────────────────────────────────────────────
# Itaú Microservices — shared environment variables
# Copy this file to .env and fill in any values you want to override.
# ─────────────────────────────────────────────────────────────────────────────

# ── AWS / LocalStack ──────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT=http://localhost:4566

# ── SQS queue URLs ────────────────────────────────────────────────────────────
SQS_QUEUE_URL=http://localhost:4566/000000000000/transactions
SQS_DLQ_URL=http://localhost:4566/000000000000/transactions-dlq

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be ≥ 32 characters; shared between LoginService and TransactionService
JWT_SECRET=ChangeThisSecretKeyForProdUseAtLeast32Chars!

# ── LoginService ──────────────────────────────────────────────────────────────
LOGIN_SERVICE_PORT=8081
LOGIN_SERVICE_URL=http://localhost:8081

# ── TransactionService ────────────────────────────────────────────────────────
TRANSACTION_SERVICE_PORT=8080
LOGIN_SERVICE_TIMEOUT_MILLIS=2000

# ── GameService ───────────────────────────────────────────────────────────────
GAME_SERVICE_PORT=8082

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── MongoDB ───────────────────────────────────────────────────────────────────
SPRING_DATA_MONGODB_HOST=localhost
SPRING_DATA_MONGODB_PORT=27017
SPRING_DATA_MONGODB_DATABASE=game_db
